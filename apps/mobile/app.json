{
  "expo": {
    "name": "POS Mitra",
    "slug": "pos-mitra",
    "version": "1.0.0",
    "icon": "./assets/pos-app-icon.png",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.posapps.mitra",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/pos-adaptive-icon.png",
        "backgroundColor": "#E3792F"
      }
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.posapps.mitra"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "position": "relative",
          "legacyVisible": "sticky-immersive"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "expo-navigation-bar": {
        "visibility": "hidden",
        "behavior": "overlay-swipe",
        "position": "relative",
        "legacyVisible": "sticky-immersive"
      },
      "eas": {
        "projectId": "09fbff75-4ce1-4d9c-8298-7ad204d73c3d"
      }
    },
    "owner": "lighter-prods-team"
  }
}

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-pos-apps.lightermediagroup.com/api/v1"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-pos-apps.lightermediagroup.com/api/v1"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
